# EmailJS configuration: https://dashboard.emailjs.com/
# These values are bundled into the public site, so treat them as public.
# In the EmailJS dashboard, restrict allowed origins to i-b-trucking.com
# and keep rate limiting on so nobody can reuse them from elsewhere.
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Driver application template (variables: first_name, last_name, mobile,
# cdl_issue_date, cdl_expiry_date, additional_info, current_date)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Optional: contact form template (variables: from_name, reply_to, phone,
# topic, message). Without it, the contact form opens the visitor's email app.
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
